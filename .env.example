# ==============================================================================
# Fichier d'exemple de configuration — FABOuanes ERP
# Copier ce fichier sous le nom .env et ajuster les valeurs pour votre environnement
# ==============================================================================

# Clé de signature de session (Générer une chaîne aléatoire sécurisée en production)
SECRET_KEY=change-this-to-a-secure-secret-key

# Paramètres du serveur Web FastAPI / Uvicorn
FAB_HOST=0.0.0.0
FAB_PORT=5000
WEB_CONCURRENCY=1
FASTAPI_ENV=production
SESSION_COOKIE_SECURE=0

# URL de connexion à la base de données PostgreSQL
# Format : postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/fabouanes

# Configuration du pool de connexions PostgreSQL
FAB_PG_POOL_SIZE=10
FAB_PG_POOL_MAX_OVERFLOW=10
FAB_PG_POOL_TIMEOUT=30

# Paramètres du compte administrateur initial
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-me-initial-pin
FAB_PASSWORD_MODE=pin

# Moteur et assistant IA Sabrina (Optionnel - Gemini API / Ollama)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite

# Cache et limitation de débit (memory ou db)
FAB_CACHE_MAX_ENTRIES=512
FAB_RATE_LIMIT_BACKEND=memory
FAB_LOG_JSON=0

# Sécurité CORS (mode serveur réseau uniquement)
# Liste d'origines autorisées séparées par des virgules.
# Laisser vide en mode desktop local (seul 127.0.0.1 est autorisé par défaut).
# Exemple : FAB_CORS_ORIGINS=http://192.168.1.50:5000,https://mondomaine.com
FAB_CORS_ORIGINS=
